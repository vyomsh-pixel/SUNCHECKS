# ===================================================
# CYBERPULSE // VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ===================================================

# 1. Server-Side Google Gemini API Key (Strictly Server-Side, NEVER exposed to client)
# Pinned model: gemini-3.8-flash for roadmap generation & task refinement
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Resend API Key (Automated 24/7 Email Dispatcher & Cron Alerts)
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Sender Email Address (Verified domain or Resend testing default)
EMAIL_FROM=CyberPulse <onboarding@resend.dev>

# 4. PostgreSQL Database URL (Vercel Postgres, Neon SQL, Supabase, or Railway)
# Automatically populated if you attach Vercel Postgres / Neon storage to your Vercel project
POSTGRES_URL=postgres://default:password@ep-cool-serverless.us-east-1.aws.neon.tech/neondb?sslmode=require

# 5. Operator Gate Passcode (Protects your HUD, real name, email, and tasks from public visitors)
# Default fallback is 2077 if omitted.
OPERATOR_PASSCODE=2077

